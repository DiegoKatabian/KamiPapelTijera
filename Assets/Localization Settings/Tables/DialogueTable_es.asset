%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DialogueTable_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: b3d3e5f8e5114244eb1eb6e5fe76e2d4, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 138154721280
    m_Localized: Jugar
    m_Metadata:
      m_Items: []
  - m_Id: 332084827242496
    m_Localized: E para avanzar
    m_Metadata:
      m_Items: []
  - m_Id: 332172047794176
    m_Localized: Hola Kami.
    m_Metadata:
      m_Items: []
  - m_Id: 332260396613632
    m_Localized: Bienvenida a mi biblioteca. Tengo muchos libros para que leamos.
    m_Metadata:
      m_Items: []
  - m_Id: 332300250890240
    m_Localized: Empezamos?
    m_Metadata:
      m_Items: []
  - m_Id: 332305120477184
    m_Localized: Muy bien. Nuestro primer libro es "Kami Papel Tijera".
    m_Metadata:
      m_Items: []
  - m_Id: 332307267960832
    m_Localized: "Lo conoc\xE9s? "
    m_Metadata:
      m_Items: []
  - m_Id: 332309033762816
    m_Localized: "Claro que lo conoc\xE9s! Si este es tu libro! Te acord\xE1s como
      empieza? "
    m_Metadata:
      m_Items: []
  - m_Id: 344823507304448
    m_Localized: <i>Narrador</i>
    m_Metadata:
      m_Items: []
  - m_Id: 347727467233280
    m_Localized: "Continuar\xE1..."
    m_Metadata:
      m_Items: []
  - m_Id: 654939758641152
    m_Localized: "T\xEDo Norberto"
    m_Metadata:
      m_Items: []
  - m_Id: 654981567463424
    m_Localized: Dalia
    m_Metadata:
      m_Items: []
  - m_Id: 655004556443648
    m_Localized: Tiburcio
    m_Metadata:
      m_Items: []
  - m_Id: 655045119557632
    m_Localized: Abuela
    m_Metadata:
      m_Items: []
  - m_Id: 655372984107008
    m_Localized: '[Kami encuentra a la abuela asustada entre los arbustos.]'
    m_Metadata:
      m_Items: []
  - m_Id: 655499480121344
    m_Localized: "Kami! Qu\xE9 bueno que viniste! Me ca\xED del barranco y no s\xE9
      c\xF3mo volver."
    m_Metadata:
      m_Items: []
  - m_Id: 655541179891712
    m_Localized: "Encima hay un Rocoso de graande! Por suerte est\xE1 dormido."
    m_Metadata:
      m_Items: []
  - m_Id: 655586474180608
    m_Localized: "Por qu\xE9 no cort\xE1s la represa y le das un buen chapuz\xF3n?
      :)"
    m_Metadata:
      m_Items: []
  - m_Id: 655892767424512
    m_Localized: "Qu\xE9 grande mi nietita! Ahora vamos para casa que tengo un hammmbre!"
    m_Metadata:
      m_Items: []
  - m_Id: 656053900001280
    m_Localized: "Ay, no sab\xE9s c\xF3mo me duele la espalda! No me dobl\xE1s y
      me llev\xE1s en tu morralcito?"
    m_Metadata:
      m_Items: []
  - m_Id: 656153699270656
    m_Localized: "[Toc\xE1 E para doblar a la abuela.]"
    m_Metadata:
      m_Items: []
  - m_Id: 656247265804288
    m_Localized: Muchas gracias por traerme Kami. Bueno, ya! Vamos a comer!
    m_Metadata:
      m_Items: []
  - m_Id: 656294703382528
    m_Localized: Pero guardate lugar para el postre porque me parece que hice un
      flancito.
    m_Metadata:
      m_Items: []
  - m_Id: 656360126136320
    m_Localized: '[ESTE ES EL FIN DE ESTE LIBRO]'
    m_Metadata:
      m_Items: []
  - m_Id: 656639550668800
    m_Localized: Chino
    m_Metadata:
      m_Items: []
  - m_Id: 656721972936704
    m_Localized: "Buenas buenas! Mir\xE1 qui\xE9n lleg\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 656803698950144
    m_Localized: "Che, sab\xE9s que no estoy pudiendo prender el horno? Est\xE1 muy
      fuerte el viento hoy..."
    m_Metadata:
      m_Items: []
  - m_Id: 656879393554432
    m_Localized: "Pod\xE9s traerme 100 papeles? No hace falta que los traigas ahora.
      Pod\xE9s ir y volver entre p\xE1ginas cuando quieras."
    m_Metadata:
      m_Items: []
  - m_Id: 657038307344384
    m_Localized: "Bien ah\xED! Muchas gracias por los papeles."
    m_Metadata:
      m_Items: []
  - m_Id: 657081387040768
    m_Localized: Para darte las gracias, voy a afilar tus tijeras.
    m_Metadata:
      m_Items: []
  - m_Id: 657144913969152
    m_Localized: "Listo, ahora pod\xE9s cortar piedras! \nEspero que te sirva!"
    m_Metadata:
      m_Items: []
  - m_Id: 657248433586176
    m_Localized: "Buen d\xEDa Kami!"
    m_Metadata:
      m_Items: []
  - m_Id: 657286689832960
    m_Localized: "Perd\xF3n que te moleste pero necesito tu ayuda con algo. "
    m_Metadata:
      m_Items: []
  - m_Id: 657288740847616
    m_Localized: "Estoy haciendo unas pociones especiales pero me qued\xE9 sin flores!"
    m_Metadata:
      m_Items: []
  - m_Id: 657290133356544
    m_Localized: "Son grandotas y llamativas, pero no puedo dejar mi puestito para
      ir a buscarlas! Vos podr\xE1s traerme tres de ellas?"
    m_Metadata:
      m_Items: []
  - m_Id: 657748046495744
    m_Localized: "Kami, no podr\xE1s traerme tres flores por favor? "
    m_Metadata:
      m_Items: []
  - m_Id: 657925180342272
    m_Localized: "Gracias por traerme las flores! Sos lo m\xE1s!"
    m_Metadata:
      m_Items: []
  - m_Id: 657926950338560
    m_Localized: "Por haber sido taan buena conmigo te voy a regalar estos papeles.
      S\xE9 que sos re talentosa con los origamis, seguro te sirven para algo!"
    m_Metadata:
      m_Items: []
  - m_Id: 657928351236096
    m_Localized: '[Kami recibe 50 papeles de Dalia.]'
    m_Metadata:
      m_Items: []
  - m_Id: 658716536455168
    m_Localized: Gracias por traerme las flores!
    m_Metadata:
      m_Items: []
  - m_Id: 660063197446144
    m_Localized: "Kami, Kami! Me ten\xE9s que ayudar!"
    m_Metadata:
      m_Items: []
  - m_Id: 660088149360640
    m_Localized: "La abuela se perdi\xF3 de nuevo. Se fue a hacer su caminata y todav\xEDa
      no volvi\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 660089567035392
    m_Localized: "Pod\xE9s ir a buscarla? Yo acabo de tirar los choris y tengo miedo
      que se me quemen."
    m_Metadata:
      m_Items: []
  - m_Id: 660091592884224
    m_Localized: "Agarrate la tijera, est\xE1 al lado del quincho."
    m_Metadata:
      m_Items: []
  - m_Id: 660424608038912
    m_Localized: "Us\xE1 tu tijera y tu magia de origami para encontrar a la abuela
      y traerla!"
    m_Metadata:
      m_Items: []
  - m_Id: 660494095073280
    m_Localized: "Volviste a buscar tus Botas de Lectura R\xE1pida, no? Las dejaste
      ac\xE1. Con estas pod\xE9s ir m\xE1s r\xE1pido por el libro."
    m_Metadata:
      m_Items: []
  - m_Id: 660496028647424
    m_Localized: "[Kami recibe sus Botas de Lectura R\xE1pida. Manten\xE9 SHIFT para
      ir r\xE1pido.]"
    m_Metadata:
      m_Items: []
  - m_Id: 660498415206400
    m_Localized: "Y? Encontraste a la abuela? D\xF3nde est\xE1?"
    m_Metadata:
      m_Items: []
  - m_Id: 660504731828224
    m_Localized: "[Toc\xE1 E para desdoblar a la abuela.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661274998980608
    m_Localized: "Qu\xE9 ingenioso traer a la Abuela doblada. Nunca vi eso!"
    m_Metadata:
      m_Items: []
  - m_Id: 661432029528064
    m_Localized: "Kami, Kami! Me ten\xE9s que ayudar!"
    m_Metadata:
      m_Items: []
  - m_Id: 661435837956096
    m_Localized: "Las gallinas quedaron atrapadas del otro lado del r\xEDo! "
    m_Metadata:
      m_Items: []
  - m_Id: 661449255534592
    m_Localized: "Vos podr\xEDas cortar el \xE1rbol para hacerles un puente?"
    m_Metadata:
      m_Items: []
  - m_Id: 661548048171008
    m_Localized: "Necesito que cortes ese \xE1rbol!"
    m_Metadata:
      m_Items: []
  - m_Id: 661576607186944
    m_Localized: "Gracias! Mir\xE1, las gallinas ya est\xE1n cruzando. Tom\xE1 esto
      como recompensa."
    m_Metadata:
      m_Items: []
  - m_Id: 661588523204608
    m_Localized: "[Ahora pod\xE9s caminar sobre el agua!]"
    m_Metadata:
      m_Items: []
  - m_Id: 661653480390656
    m_Localized: "Gracias por darme una mano Kami! Las gallinas est\xE1n felices
      en el rancho."
    m_Metadata:
      m_Items: []
  - m_Id: 661833231482880
    m_Localized: '[Las chicas disfrutan un rico chori.]'
    m_Metadata:
      m_Items: []
  - m_Id: 661836435931136
    m_Localized: '[La gigante mano del Narrador aparece.]'
    m_Metadata:
      m_Items: []
  - m_Id: 661838587609088
    m_Localized: "Qu\xE9 hiciste?! Ven\xED para ac\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 661840252747776
    m_Localized: "Qu\xE9 es eso de hacer origamis de los dem\xE1s personajes?"
    m_Metadata:
      m_Items: []
  - m_Id: 661841552982016
    m_Localized: "No pod\xE9s andar cambiando las historias! Se supon\xEDa que la
      abuela no lograba salir de esa p\xE1gina..."
    m_Metadata:
      m_Items: []
  - m_Id: 661842916130816
    m_Localized: "Ahora vamos a leer otro libro, \n\"Kami, Tinta y Condena\". A ver
      si aprend\xE9s..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000000
    m_Localized: Natalia
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000196
    m_Localized: "Narrador"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000197
    m_Localized: "???"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000001
    m_Localized: "[Kami encuentra a una chica con cara de preocupada.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000002
    m_Localized: "...entre Ariel que no me deja en paz, los robos al museo, y este caf\xE9 que estaba car\xEDsimo, no s\xE9 qu\xE9 voy a hacer. Ya estoy hart-"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000003
    m_Localized: "Ay, perd\xF3n, no te vi. \xBFQu\xE9 necesit\xE1s?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000004
    m_Localized: "[...]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000005
    m_Localized: "\xBFAs\xED que te trajeron desde otro libro? \xA1Con raz\xF3n tu tinta es tan distinta!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000006
    m_Localized: "Mi nombre es Natalia, soy detective privada. Justo me estaba tomando un caf\xE9 mientras intentaba resolver un caso."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000190
    m_Localized: "Hubo una serie de robos al museo, y nadie puede encontrar al ladr\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000191
    m_Localized: "...\xFAltimo momento: \xA1otro incidente en el museo de la ciudad! Habr\xEDa sido robado un Pelusa original, valuado en 20 millones de d\xF3lares..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000192
    m_Localized: "\xBFOtro m\xE1s? \xA1\xBFJusto ahora?! \xA1Las obras de ese artista son muy valiosas, tenemos que ir a investigar ya!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000193
    m_Localized: "Te propongo algo: ayudame a resolver este caso, y yo te ayudo a volver a tu libro."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000194
    m_Localized: "Ah, pero antes: \xBFpodr\xEDas guardar el ticket de la compra? Nos puede llegar a servir."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000125
    m_Localized: "\xBFY el ticket? Doblalo, que nos puede llegar a servir."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000195
    m_Localized: "\xA1Ahora s\xED! \xA1Vayamos al museo a buscar pistas!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000198
    m_Localized: "No se puede pasar. Nuestros agentes est\xE1n investigando la escena."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000199
    m_Localized: "Aunque todav\xEDa no encontraron nada..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000100
    m_Localized: "[Kami encuentra una pista dentro del tacho de basura.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000200
    m_Localized: "Mir\xE1, Kami, parece que el ladr\xF3n quiso deshacerse de sus guantes..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000201
    m_Localized: "Pero tir\xF3 solo uno. Sigamos buscando m\xE1s pistas."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000101
    m_Localized: "[Kami encuentra una pista enganchada al limpiaparabrisas de un auto.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000202
    m_Localized: "Mir\xE1, Kami, \xA1parece que al ladr\xF3n se le perdi\xF3 el sombrero!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000203
    m_Localized: "Este ladr\xF3n es bastante despistado."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000103
    m_Localized: "Se fueron los polic\xEDas que cuidaban la entrada. \xA1Es nuestro momento para escabullirnos dentro del museo!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000102
    m_Localized: "[Kami encuentra una pista en el piso, rodeada de vidrios rotos.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000204
    m_Localized: "Mir\xE1, Kami, parece que al ladr\xF3n se le cay\xF3 el reloj al piso y se parti\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000205
    m_Localized: "Hora del robo: 20:30 horas."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000105
    m_Localized: "\xA1Se le acab\xF3 el tiempo! Llevemos estas tres pistas a mi casa para analizarlas y develar este misterio."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000107
    m_Localized: "\xBFUn regalo gigante... en mi puerta? \xBFQu\xE9 es esto?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000108
    m_Localized: "Cort\xE1 la cinta y veamos qu\xE9 es."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000109
    m_Localized: "Cort\xE1 la cinta y veamos qu\xE9 es ese misterioso regalo."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000110
    m_Localized: "Ariel"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000111
    m_Localized: "Polic\xEDa Federal"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000112
    m_Localized: "Kami, no lo puedo creer, \xA1es el Pelusa original! \xA1\xBFEl ladr\xF3n trajo esto ac\xE1?!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000113
    m_Localized: "Tenemos que devolverlo al museo, pero..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000114
    m_Localized: "\xA1Mir\xE1! Hay una carta adentro, \xBFpod\xE9s leer qu\xE9 dice?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000115
    m_Localized: "\xA1Polic\xEDa Federal! \xA1Alto las manos!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000116
    m_Localized: "Ah\xED las tienen a las ladronas. Arr\xE9stenlas."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000117
    m_Localized: "Ariel, \xBFqu\xE9 hac\xE9s? \xBFPod\xE9s parar de molestarme?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000120
    m_Localized: "Nosotras no robamos nada. \xBFQu\xE9 es esta broma de mal gusto?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000119
    m_Localized: "\xA1Ac\xE1 hay una carta! Dice... bla bla bla... bla bla bla... \"esta es tu parte del robo\"."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000118
    m_Localized: "Bueno, queda bastante claro que son culpables."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000206
    m_Localized: "\xA1No! \xA1Paren! \xA1Nos enmarcaron!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000186
    m_Localized: "\xA1Ac\xE1 van a quedarse encerradas para siempre! \xA1Malditas embusteras!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000207
    m_Localized: "Y ni se les ocurra escapar. \xA1Si las veo, las voy a mandar de vuelta a su celda de una patada!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000187
    m_Localized: "\xA1Callate! \xA1No somos unas malditas embusteras!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000208
    m_Localized: "\xA1Kami, tenemos que encontrar la manera de salir!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000123
    m_Localized: "[Kami no encuentra ninguna escapatoria, y todo parece perdido...]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000209
    m_Localized: "[Pero de repente, un fuerte temblor sacude la comisar\xEDa.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000121
    m_Localized: "\xA1Sorpresaaa! \xA1Ay, no sab\xE9s lo que me pas\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000122
    m_Localized: "\xBFQu\xE9 fue ese ruido?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000210
    m_Localized: "Bueno, despu\xE9s te cuento. Agarremos nuestras cosas y salgamos de ac\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000188
    m_Localized: "\xA1Gracias por salvarme, Kami! \xA1Hola! \xBFEsta es tu abuela que se perdi\xF3 tambi\xE9n?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000211
    m_Localized: "Bueno, despu\xE9s nos cont\xE1s. Ahora tenemos que escaparnos por esa ventana de all\xE1 arriba. Pero \xBFc\xF3mo hacemos para llegar ah\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000212
    m_Localized: "\xA1Incre\xEDble! No sab\xEDa que eras una experta del origami."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000213
    m_Localized: "\xA1Volvamos r\xE1pido al museo!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000124
    m_Localized: Grace
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000130
    m_Localized: Soy Grace, directora de este museo. Sin pruebas, me temo que no
      puedo creerles ni una palabra.
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000134
    m_Localized: "\xBFY bien? A ver ese ticket."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000144
    m_Localized: "La catapulta est\xE1 lista cuando quieran. \xA1No te olvides de
      despedirte de Natalia!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000189
    m_Localized: "[Kami y las chicas llegan al museo, donde la polic\xEDa y Ariel interrogan a una chica.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000214
    m_Localized: "...y habr\xE1 sido como a las ocho y media."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000215
    m_Localized: "Se\xF1oritas, \xBFqu\xE9 quieren ahora? El museo est\xE1 cerrado."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000151
    m_Localized: "\xA1Ah\xED est\xE1n las fugitivas, con el Pelusa todav\xEDa en la mano!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000152
    m_Localized: "\xA1Nadie se mueva! \xA1Ustedes dos vuelven derechito a sus celdas!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000153
    m_Localized: "Chicas, \xBFqu\xE9 hicieron ahora?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000154
    m_Localized: "\xA1Abuela!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000155
    m_Localized: "Esperen, oficiales. Si estas chicas robaron el Pelusa, \xBFpor qu\xE9 lo traer\xEDan de vuelta?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000216
    m_Localized: "Yo soy Grace, la directora del museo. \xBFQu\xE9 tienen para decir?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000217
    m_Localized: "\xA1Nosotras no robamos el Pelusa! Nos enmarcaron para hacernos quedar como las ladronas, pero nosotras no fuimos."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000218
    m_Localized: "No les cree nadie."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000219
    m_Localized: "\xA1Puedo probarlo, miren!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000220
    m_Localized: "Kami, mostrales el ticket del caf\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000172
    m_Localized: "\xBFVen? \xA1Dice 20:30! \xA1A la hora del robo nosotras est\xE1bamos en la cafeter\xEDa! \xA1Es imposible que hayamos sido nosotras!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000173
    m_Localized: "Eso no prueba nada. Ese ticket puede ser falso."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000174
    m_Localized: "\xA1No! \xA1Basta de molestarme! Adem\xE1s, \xA1miren esto!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000175
    m_Localized: "Encontramos el sombrero de Ariel y uno de sus guantes en la escena del robo. Y a \xE9l justo le falta el sombrero y un guante."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000176
    m_Localized: "\xA1Y tambi\xE9n encontramos tu reloj! Con la hora marcada: 20:30 hs."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000177
    m_Localized: "Incre\xEDble... Adem\xE1s, Ariel, tu padre es el mayor benefactor del museo. Seguro usaste sus llaves para entrar a la sala del Pelusa."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000178
    m_Localized: "Mmm, todo cierra. Eso explica los otros robos tambi\xE9n. Se\xF1oritas, creo que les debemos unas disculpas."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000179
    m_Localized: "Usted Ariel, nos va a tener que acompa\xF1ar."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000180
    m_Localized: "\xA1No, est\xE1n locas! \xA1No saben lo que dicen!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000181
    m_Localized: "Sos re mala persona, Ariel. \xBFPor qu\xE9 quer\xEDas que me echen la culpa a m\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000221
    m_Localized: "No te voy a decir..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000222
    m_Localized: "..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000223
    m_Localized: "..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000224
    m_Localized: "..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000225
    m_Localized: "..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000226
    m_Localized: "Es que ten\xEDa miedo de que una buena detective como vos descubra mis robos."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000227
    m_Localized: "\xA1Y todo hubiera salido bien si no fuera por esa chica con las tijeras!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000228
    m_Localized: "Bueno ya, circule caballero por favor."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000182
    m_Localized: "Tremendo trabajo, chicas. El Pelusa volvi\xF3 a casa gracias a ustedes."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000183
    m_Localized: "Hay una cosa m\xE1s, Grace. Kami no es de ac\xE1, tiene que volver a su libro."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000184
    m_Localized: "Mmm..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000185
    m_Localized: "Si no les da miedo, podr\xEDan usar la catapulta antigua."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000229
    m_Localized: "A m\xED no me da miedo."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000230
    m_Localized: "\xA1Genial entonces! Cuando est\xE9n listas para salir, s\xFAbanse a la catapulta."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000231
    m_Localized: "No se olviden de saludar a Natalia antes de irse."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000145
    m_Localized: "As\xED que esto es resolver un caso con una socia. Mucho mejor que hacerlo sola."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000146
    m_Localized: "Gracias por tu ayuda, Kami. Espero que nos volvamos a ver pronto."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000147
    m_Localized: "Cuando est\xE9s lista, cort\xE1 la soga, nena."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000148
    m_Localized: Kami y su abuela volaron sobre los techos del diario, derechito
      hacia el pliegue de su propio libro...
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000149
    m_Localized: "...hasta que chocaron contra algo grande, redondo y azul: la l\xE1mpara
      del escritorio del Narrador."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000150
    m_Localized: "Desviadas, cayeron entre las p\xE1ginas de un libro que nunca hab\xEDan
      le\xEDdo."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000169
    m_Localized: "RADIO"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
