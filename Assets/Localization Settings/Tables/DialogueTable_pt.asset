%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DialogueTable_pt
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pt
  m_SharedData: {fileID: 11400000, guid: b3d3e5f8e5114244eb1eb6e5fe76e2d4, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 138154721280
    m_Localized: Jogar
    m_Metadata:
      m_Items: []
  - m_Id: 332084827242496
    m_Localized: "E para avan\xE7ar"
    m_Metadata:
      m_Items: []
  - m_Id: 332172047794176
    m_Localized: "Ol\xE1 Kami."
    m_Metadata:
      m_Items: []
  - m_Id: 332260396613632
    m_Localized: "Bem-vindos \xE0 minha biblioteca. Tenho muitos livros para lermos."
    m_Metadata:
      m_Items: []
  - m_Id: 332300250890240
    m_Localized: "Vamos come\xE7ar?"
    m_Metadata:
      m_Items: []
  - m_Id: 332305120477184
    m_Localized: "Muito bom. Nosso primeiro livro \xE9 \"Kami Papel Tisoura\"."
    m_Metadata:
      m_Items: []
  - m_Id: 332307267960832
    m_Localized: "Voc\xEA o conhece?"
    m_Metadata:
      m_Items: []
  - m_Id: 332309033762816
    m_Localized: "Claro que voc\xEA sabe! Este \xE9 o seu livro! Voc\xEA se lembra
      de como come\xE7a?"
    m_Metadata:
      m_Items: []
  - m_Id: 344823507304448
    m_Localized: <i>Narrador</i>
    m_Metadata:
      m_Items: []
  - m_Id: 347727467233280
    m_Localized: Continua...
    m_Metadata:
      m_Items: []
  - m_Id: 654939758641152
    m_Localized: Tio Norberto
    m_Metadata:
      m_Items: []
  - m_Id: 654981567463424
    m_Localized: "D\xE1lia"
    m_Metadata:
      m_Items: []
  - m_Id: 655004556443648
    m_Localized: Tiburcio
    m_Metadata:
      m_Items: []
  - m_Id: 655045119557632
    m_Localized: "Av\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 655372984107008
    m_Localized: "[Kami encontra a av\xF3 assustada entre os arbustos.]"
    m_Metadata:
      m_Items: []
  - m_Id: 655499480121344
    m_Localized: "Kami! Que bom que voc\xEA veio! Eu ca\xED do penhasco e n\xE3o
      sei como voltar."
    m_Metadata:
      m_Items: []
  - m_Id: 655541179891712
    m_Localized: "Tem um Rocky enorme l\xE1 em cima! Por sorte, ele est\xE1 dormindo."
    m_Metadata:
      m_Items: []
  - m_Id: 655586474180608
    m_Localized: "Por que voc\xEA n\xE3o corta a represa e d\xE1 uma boa lavada nela?
      :)"
    m_Metadata:
      m_Items: []
  - m_Id: 655892767424512
    m_Localized: "Minha neta est\xE1 t\xE3o grande! Agora vamos para casa, estou
      morrendo de fome!"
    m_Metadata:
      m_Items: []
  - m_Id: 656053900001280
    m_Localized: "Nossa, voc\xEA n\xE3o imagina o quanto minhas costas doem! \u200B\u200BVoc\xEA
      poderia me dobrar para que eu possa ser carregada na sua mochilinha?"
    m_Metadata:
      m_Items: []
  - m_Id: 656153699270656
    m_Localized: '[Toca E para dobrar a Granny.]'
    m_Metadata:
      m_Items: []
  - m_Id: 656247265804288
    m_Localized: "Muito obrigada, Kami. J\xE1 consigo sentir o cheiro das salsichas
      dentro da minha mochila. Vamos, vamos comer!"
    m_Metadata:
      m_Items: []
  - m_Id: 656294703382528
    m_Localized: "Mas guarde espa\xE7o para a sobremesa, porque eu fiz um monte de
      biscoitos!"
    m_Metadata:
      m_Items: []
  - m_Id: 656360126136320
    m_Localized: "[ESTE \xC9 O FIM DESTE LIVRO]"
    m_Metadata:
      m_Items: []
  - m_Id: 656639550668800
    m_Localized: "chin\xEAs"
    m_Metadata:
      m_Items: []
  - m_Id: 656721972936704
    m_Localized: "Bom dia! Olha quem est\xE1 aqui!"
    m_Metadata:
      m_Items: []
  - m_Id: 656803698950144
    m_Localized: "Ei, voc\xEA sabia que o forno n\xE3o liga? O vento est\xE1 muito
      forte hoje..."
    m_Metadata:
      m_Items: []
  - m_Id: 656879393554432
    m_Localized: "Voc\xEA pode me trazer 100 folhas de papel? N\xE3o se preocupe,
      voc\xEA n\xE3o precisa traz\xEA-las agora. Voc\xEA pode ir e voltar entre as
      p\xE1ginas quando quiser."
    m_Metadata:
      m_Items: []
  - m_Id: 657038307344384
    m_Localized: "\xD3timo! Muito obrigada. Agora me passe a tesoura por um instante."
    m_Metadata:
      m_Items: []
  - m_Id: 657081387040768
    m_Localized: "Muito bem, aqui est\xE1. Agora voc\xEA pode cortar algumas pedras
      com a sua tesoura!"
    m_Metadata:
      m_Items: []
  - m_Id: 657144913969152
    m_Localized: "Espero que a tesoura melhorada seja \xFAtil para voc\xEA!"
    m_Metadata:
      m_Items: []
  - m_Id: 657248433586176
    m_Localized: Bom dia, Kami!
    m_Metadata:
      m_Items: []
  - m_Id: 657286689832960
    m_Localized: Desculpe incomodar, mas preciso muito da sua ajuda com algo.
    m_Metadata:
      m_Items: []
  - m_Id: 657288740847616
    m_Localized: "Estou preparando algumas po\xE7\xF5es especiais, mas acabei de
      ficar sem FLORES VIOLETA, preciso delas desesperadamente!"
    m_Metadata:
      m_Items: []
  - m_Id: 657290133356544
    m_Localized: "Elas s\xE3o grandes e chamam muita aten\xE7\xE3o, mas n\xE3o posso
      sair da minha barraca para ir busc\xE1-las! Por favor, voc\xEA poderia encontrar
      tr\xEAs e trazer para mim? Obrigada, Kami, voc\xEA \xE9 demais!"
    m_Metadata:
      m_Items: []
  - m_Id: 657748046495744
    m_Localized: "As flores violetas s\xE3o como estas que voc\xEA v\xEA aqui. Voc\xEA
      poderia me trazer tr\xEAs, por favor?"
    m_Metadata:
      m_Items: []
  - m_Id: 657925180342272
    m_Localized: Obrigada por me trazer as flores!
    m_Metadata:
      m_Items: []
  - m_Id: 657926950338560
    m_Localized: "Como voc\xEA tem sido t\xE3o gentil comigo, vou te dar estes pap\xE9is.
      Sei que voc\xEA tem muito talento para origami, ent\xE3o tenho certeza de que
      voc\xEA os usar\xE1 muito bem!"
    m_Metadata:
      m_Items: []
  - m_Id: 657928351236096
    m_Localized: '[Kami recebe 50 documentos de Dalia.]'
    m_Metadata:
      m_Items: []
  - m_Id: 658716536455168
    m_Localized: Obrigada por me trazer as flores!
    m_Metadata:
      m_Items: []
  - m_Id: 660063197446144
    m_Localized: "Kami, Kami! Voc\xEA tem que me ajudar!"
    m_Metadata:
      m_Items: []
  - m_Id: 660088149360640
    m_Localized: "A vov\xF3 sumiu de novo. Ela saiu para dar uma caminhada h\xE1
      pouco e ainda n\xE3o voltou!"
    m_Metadata:
      m_Items: []
  - m_Id: 660089567035392
    m_Localized: "Voc\xEA n\xE3o vai procur\xE1-la? Estou prestes a colocar as lingui\xE7as
      na grelha, o churrasco vai ficar arruinado de novo!"
    m_Metadata:
      m_Items: []
  - m_Id: 660091592884224
    m_Localized: "Pegue a TESOURA, ela est\xE1 perto da galp\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 660424608038912
    m_Localized: "V\xE1 procurar a vov\xF3, vamos comer!"
    m_Metadata:
      m_Items: []
  - m_Id: 660494095073280
    m_Localized: "Voc\xEA voltou para pegar suas Botas de Leitura Din\xE2mica, n\xE3o
      foi? Voc\xEA as deixou aqui. Com elas, voc\xEA consegue ler o livro mais r\xE1pido."
    m_Metadata:
      m_Items: []
  - m_Id: 660496028647424
    m_Localized: "[Kami recebe suas Botas de Leitura R\xE1pida. Segure SHIFT para
      ir mais r\xE1pido.]"
    m_Metadata:
      m_Items: []
  - m_Id: 660498415206400
    m_Localized: "E a\xED? Encontrou a vov\xF3? Onde ela est\xE1?"
    m_Metadata:
      m_Items: []
  - m_Id: 660504731828224
    m_Localized: "[Pressiona a tecla E para desdobrar a av\xF3.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661274998980608
    m_Localized: "Joya, diga \xE0 vov\xF3 que as salsichas est\xE3o prontas!"
    m_Metadata:
      m_Items: []
  - m_Id: 661432029528064
    m_Localized: Kami! Por favor, me ajude!
    m_Metadata:
      m_Items: []
  - m_Id: 661435837956096
    m_Localized: "As galinhas est\xE3o presas do outro lado do rio! Preciso que voc\xEA
      corte aquela \xE1rvore para que caia e fa\xE7a uma ponte."
    m_Metadata:
      m_Items: []
  - m_Id: 661449255534592
    m_Localized: "Voc\xEA por acaso n\xE3o tem uma tesoura?"
    m_Metadata:
      m_Items: []
  - m_Id: 661548048171008
    m_Localized: "Preciso que voc\xEA corte aquela \xE1rvore!"
    m_Metadata:
      m_Items: []
  - m_Id: 661576607186944
    m_Localized: "Obrigada! Veja, as galinhas j\xE1 est\xE3o atravessando. Aqui,
      tome isso como recompensa."
    m_Metadata:
      m_Items: []
  - m_Id: 661588523204608
    m_Localized: "[Com essas botas de \xE1gua, voc\xEA n\xE3o ter\xE1 medo do rio!]"
    m_Metadata:
      m_Items: []
  - m_Id: 661653480390656
    m_Localized: "Obrigada pela ajuda, Kami! As galinhas est\xE3o felizes na faz\xEDenda."
    m_Metadata:
      m_Items: []
  - m_Id: 661833231482880
    m_Localized: "[As meninas est\xE3o saboreando um delicioso chouri\xE7o.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661836435931136
    m_Localized: "[A m\xE3o gigante do Narrador aparece.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661838587609088
    m_Localized: "O que voc\xEA fez?! Venha aqui."
    m_Metadata:
      m_Items: []
  - m_Id: 661840252747776
    m_Localized: Por que fazer figuras de origami dos outros personagens?
    m_Metadata:
      m_Items: []
  - m_Id: 661841552982016
    m_Localized: "Voc\xEA n\xE3o pode ficar mudando as hist\xF3rias assim! A vov\xF3
      nunca deveria ter sa\xEDdo daquela p\xE1gina..."
    m_Metadata:
      m_Items: []
  - m_Id: 661842916130816
    m_Localized: "Agora vamos ler outro livro,\n\n\"Crime, Castigo e Sangue\". Vamos
      ver se voc\xEA aprende alguma coisa..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000000
    m_Localized: Natalia
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000196
    m_Localized: "Narrador"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000197
    m_Localized: "???"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000001
    m_Localized: "[Kami encontra uma garota com cara de preocupada.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000002
    m_Localized: "...entre o Ariel que n\xE3o me deixa em paz, os roubos no museu e este caf\xE9 que estava car\xEDssimo, n\xE3o sei o que vou fazer. J\xE1 estou far-"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000003
    m_Localized: "Ai, desculpa, n\xE3o te vi. Do que voc\xEA precisa?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000004
    m_Localized: "[...]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000005
    m_Localized: "Ent\xE3o te trouxeram de outro livro? Com raz\xE3o a sua tinta \xE9 t\xE3o diferente!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000006
    m_Localized: "Meu nome \xE9 Natalia, sou detetive particular. Estava tomando um caf\xE9 enquanto tentava resolver um caso."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000190
    m_Localized: "Houve uma s\xE9rie de roubos no museu, e ningu\xE9m consegue encontrar o ladr\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000191
    m_Localized: "...\xFAltima hora: outro incidente no museu da cidade! Teria sido roubado um Pelusa original, avaliado em 20 milh\xF5es de d\xF3lares..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000192
    m_Localized: "Mais um? Justo agora?! As obras desse artista s\xE3o muito valiosas, temos que ir investigar j\xE1!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000193
    m_Localized: "Te proponho uma coisa: me ajude a resolver este caso, e eu te ajudo a voltar para o seu livro."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000194
    m_Localized: "Ah, mas antes: voc\xEA poderia guardar o recibo da compra? Pode ser \xFAtil pra n\xF3s."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000125
    m_Localized: "E o recibo? Dobra a\xED, pode ser \xFAtil pra n\xF3s."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000195
    m_Localized: "Agora sim! Vamos ao museu procurar pistas!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000198
    m_Localized: "N\xE3o pode passar. Nossos agentes est\xE3o investigando a cena."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000199
    m_Localized: "Embora ainda n\xE3o tenham encontrado nada..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000100
    m_Localized: "[Kami encontra uma pista dentro da lixeira.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000200
    m_Localized: "Olha, Kami, parece que o ladr\xE3o tentou se livrar das luvas..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000201
    m_Localized: "Mas jogou fora s\xF3 uma. Vamos continuar procurando mais pistas."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000101
    m_Localized: "[Kami encontra uma pista presa no limpador de para-brisa de um carro.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000202
    m_Localized: "Olha, Kami, parece que o ladr\xE3o perdeu o chap\xE9u!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000203
    m_Localized: "Esse ladr\xE3o \xE9 bem distra\xEDdo."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000103
    m_Localized: "Os policiais que vigiavam a entrada foram embora. \xC9 a nossa chance de entrar escondido no museu!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000102
    m_Localized: "[Kami encontra uma pista no ch\xE3o, rodeada de vidro quebrado.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000204
    m_Localized: "Olha, Kami, parece que o ladr\xE3o deixou o rel\xF3gio cair no ch\xE3o e ele quebrou."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000205
    m_Localized: "Hora do roubo: 20:30."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000105
    m_Localized: "O tempo do ladr\xE3o acabou! Vamos levar essas tr\xEAs pistas pra minha casa, analisar tudo e desvendar esse mist\xE9rio."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000107
    m_Localized: "Um presente gigante... na minha porta? O que \xE9 isso?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000108
    m_Localized: "Corta a fita e vamos ver o que \xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000109
    m_Localized: "Corta a fita e vamos ver que presente misterioso \xE9 esse."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000110
    m_Localized: "Ariel"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000111
    m_Localized: "Pol\xEDcia"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000112
    m_Localized: "Kami, n\xE3o acredito, \xE9 o Pelusa original! O ladr\xE3o trouxe isso pra c\xE1?!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000113
    m_Localized: "Temos que devolver ao museu, mas..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000114
    m_Localized: "Olha! Tem uma carta a\xED dentro, voc\xEA consegue ler o que diz?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000115
    m_Localized: "Pol\xEDcia! M\xE3os ao alto!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000116
    m_Localized: "A\xED est\xE3o as ladras. Prendam elas."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000117
    m_Localized: "Ariel, o que voc\xEA est\xE1 fazendo? D\xE1 pra parar de me incomodar?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000120
    m_Localized: "N\xF3s n\xE3o roubamos nada. Que brincadeira de mau gosto \xE9 essa?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000119
    m_Localized: "Aqui tem uma carta! Diz... bl\xE1 bl\xE1 bl\xE1... bl\xE1 bl\xE1 bl\xE1... \"esta \xE9 a sua parte do roubo\"."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000118
    m_Localized: "Bom, est\xE1 bem claro que elas s\xE3o culpadas."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000206
    m_Localized: "N\xE3o! Parem! Nos incriminaram!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000186
    m_Localized: "Voc\xEAs duas v\xE3o ficar trancadas aqui para sempre! Malditas mentirosas!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000207
    m_Localized: "E nem pensem em fugir. Se eu vir voc\xEAs, vou mandar de volta pra cela na base do chute!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000187
    m_Localized: "Cala a boca! N\xF3s n\xE3o somos umas malditas mentirosas!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000208
    m_Localized: "Kami, a gente precisa achar um jeito de sair!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000123
    m_Localized: "[Kami n\xE3o encontra nenhuma sa\xEDda, e tudo parece perdido...]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000209
    m_Localized: "[Mas, de repente, um forte tremor sacode a delegacia.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000121
    m_Localized: "Surpresaaa! Ai, voc\xEA n\xE3o faz ideia do que me aconteceu!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000122
    m_Localized: "Que barulho foi esse?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000210
    m_Localized: "Bom, depois eu te conto. Vamos pegar as nossas coisas e sair daqui."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000188
    m_Localized: "Obrigada por me salvar, Kami! Oi! Essa \xE9 a sua av\xF3 que tamb\xE9m se perdeu?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000211
    m_Localized: "Bom, depois voc\xEA nos conta. Agora a gente precisa fugir por aquela janela l\xE1 em cima. Mas como a gente faz pra chegar l\xE1?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000212
    m_Localized: "Incr\xEDvel! Eu n\xE3o sabia que voc\xEA era uma especialista em origami."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000213
    m_Localized: "Vamos voltar r\xE1pido para o museu!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000124
    m_Localized: Grace
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000130
    m_Localized: "Sou a Grace, diretora deste museu. Sem provas, receio que n\xE3o
      posso acreditar em nada do que dizem."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000134
    m_Localized: "E ent\xE3o? Vamos ver esse recibo."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000144
    m_Localized: "A catapulta est\xE1 pronta quando voc\xEAs quiserem. N\xE3o esquece
      de se despedir da Natalia!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000189
    m_Localized: "[Kami e as garotas chegam ao museu, onde a pol\xEDcia e o Ariel interrogam uma mo\xE7a.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000214
    m_Localized: "...e deve ter sido por volta das oito e meia."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000215
    m_Localized: "Mo\xE7as, o que voc\xEAs querem agora? O museu est\xE1 fechado."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000151
    m_Localized: "Ali est\xE3o as fugitivas, ainda com o Pelusa na m\xE3o!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000152
    m_Localized: "Ningu\xE9m se mexa! Voc\xEAs duas v\xE3o direto de volta para as suas celas!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000153
    m_Localized: "Meninas, o que voc\xEAs aprontaram agora?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000154
    m_Localized: "Vov\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000155
    m_Localized: "Esperem, oficiais. Se essas garotas roubaram o Pelusa, por que o trariam de volta?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000216
    m_Localized: "Eu sou a Grace, a diretora do museu. O que voc\xEAs t\xEAm a dizer?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000217
    m_Localized: "N\xF3s n\xE3o roubamos o Pelusa! Armaram pra cima da gente para parecermos as ladras, mas n\xE3o fomos n\xF3s."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000218
    m_Localized: "Ningu\xE9m acredita em voc\xEAs."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000219
    m_Localized: "Eu posso provar, olhem!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000220
    m_Localized: "Kami, mostra pra eles o ticket do caf\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000232
    m_Localized: "Eita! Que caro!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000172
    m_Localized: "Viram? Diz 20:30! Na hora do roubo n\xF3s est\xE1vamos na cafeteria! \xC9 imposs\xEDvel que tenha sido a gente!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000173
    m_Localized: "Isso n\xE3o prova nada. Esse ticket pode ser falso."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000174
    m_Localized: "N\xE3o! Chega de me incomodar! Al\xE9m disso, olhem isto!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000175
    m_Localized: "Encontramos o chap\xE9u do Ariel e uma das luvas dele na cena do roubo. E justo a ele faltam um chap\xE9u e uma luva."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000176
    m_Localized: "E tamb\xE9m encontramos o seu rel\xF3gio! Com a hora marcada: 20:30."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000177
    m_Localized: "Incr\xEDvel... Al\xE9m disso, Ariel, seu pai \xE9 o maior benfeitor do museu. Com certeza voc\xEA usou as chaves dele para entrar na sala do Pelusa."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000178
    m_Localized: "Hmm, tudo se encaixa. Isso explica os outros roubos tamb\xE9m. Mo\xE7as, acho que devemos desculpas a voc\xEAs."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000179
    m_Localized: "O senhor, Ariel, vai ter que nos acompanhar."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000180
    m_Localized: "N\xE3o, voc\xEAs est\xE3o loucas! Voc\xEAs n\xE3o sabem o que est\xE3o dizendo!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000181
    m_Localized: "Voc\xEA \xE9 uma p\xE9ssima pessoa, Ariel. Por que voc\xEA queria que botassem a culpa em mim?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000221
    m_Localized: "Eu n\xE3o vou te dizer..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000222
    m_Localized: "..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000223
    m_Localized: "..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000224
    m_Localized: "..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000225
    m_Localized: "..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000226
    m_Localized: "\xC9 que eu tinha medo de que uma boa detetive como voc\xEA descobrisse os meus roubos."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000227
    m_Localized: "E tudo teria dado certo se n\xE3o fosse por aquela garota com a tesoura!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000228
    m_Localized: "Bom, j\xE1 chega, circulando, senhor, por favor."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000182
    m_Localized: "Excelente trabalho, meninas. O Pelusa voltou para casa gra\xE7as a voc\xEAs."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000183
    m_Localized: "Tem mais uma coisa, Grace. A Kami n\xE3o \xE9 daqui, ela precisa voltar para o livro dela."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000184
    m_Localized: "Hmm..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000185
    m_Localized: "Se voc\xEAs n\xE3o tiverem medo, podem usar a catapulta antiga."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000229
    m_Localized: "Eu n\xE3o tenho medo."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000230
    m_Localized: "\xD3timo, ent\xE3o! Quando estiverem prontas para ir, subam na catapulta."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000231
    m_Localized: "N\xE3o se esque\xE7am de se despedir da Natalia antes de ir."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000145
    m_Localized: "Ent\xE3o \xE9 isso que \xE9 resolver um caso com uma parceira. Muito melhor do que fazer isso sozinha."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000146
    m_Localized: "Obrigada pela sua ajuda, Kami. Espero que a gente se veja de novo em breve."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000147
    m_Localized: "Quando voc\xEA estiver pronta, corte a corda, querida."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000148
    m_Localized: "Kami e a av\xF3 voaram por cima dos telhados do jornal, direto
      para a dobra do pr\xF3prio livro..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000149
    m_Localized: "...at\xE9 que bateram em algo grande, redondo e azul: a lumin\xE1ria
      da escrivaninha do Narrador."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000150
    m_Localized: "Desviadas, ca\xEDram entre as p\xE1ginas de um livro que nunca
      tinham lido."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000169
    m_Localized: "R\xC1DIO"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
