%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DialogueTable_pt
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pt
  m_SharedData: {fileID: 11400000, guid: b3d3e5f8e5114244eb1eb6e5fe76e2d4, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 138154721280
    m_Localized: Jogar
    m_Metadata:
      m_Items: []
  - m_Id: 332084827242496
    m_Localized: "E para avan\xE7ar"
    m_Metadata:
      m_Items: []
  - m_Id: 332172047794176
    m_Localized: "Ol\xE1 Kami."
    m_Metadata:
      m_Items: []
  - m_Id: 332260396613632
    m_Localized: "Bem-vindos \xE0 minha biblioteca. Tenho muitos livros para lermos."
    m_Metadata:
      m_Items: []
  - m_Id: 332300250890240
    m_Localized: "Vamos come\xE7ar?"
    m_Metadata:
      m_Items: []
  - m_Id: 332305120477184
    m_Localized: "Muito bom. Nosso primeiro livro \xE9 \"Kami Papel Tisoura\"."
    m_Metadata:
      m_Items: []
  - m_Id: 332307267960832
    m_Localized: "Voc\xEA o conhece?"
    m_Metadata:
      m_Items: []
  - m_Id: 332309033762816
    m_Localized: "Claro que voc\xEA sabe! Este \xE9 o seu livro! Voc\xEA se lembra
      de como come\xE7a?"
    m_Metadata:
      m_Items: []
  - m_Id: 344823507304448
    m_Localized: <i>Narrador</i>
    m_Metadata:
      m_Items: []
  - m_Id: 347727467233280
    m_Localized: Continua...
    m_Metadata:
      m_Items: []
  - m_Id: 654939758641152
    m_Localized: Tio Norberto
    m_Metadata:
      m_Items: []
  - m_Id: 654981567463424
    m_Localized: "D\xE1lia"
    m_Metadata:
      m_Items: []
  - m_Id: 655004556443648
    m_Localized: Tiburcio
    m_Metadata:
      m_Items: []
  - m_Id: 655045119557632
    m_Localized: "Av\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 655372984107008
    m_Localized: "[Kami encontra a av\xF3 assustada entre os arbustos.]"
    m_Metadata:
      m_Items: []
  - m_Id: 655499480121344
    m_Localized: "Kami! Que bom que voc\xEA veio! Eu ca\xED do penhasco e n\xE3o
      sei como voltar."
    m_Metadata:
      m_Items: []
  - m_Id: 655541179891712
    m_Localized: "Tem um Rocky enorme l\xE1 em cima! Por sorte, ele est\xE1 dormindo."
    m_Metadata:
      m_Items: []
  - m_Id: 655586474180608
    m_Localized: "Por que voc\xEA n\xE3o corta a represa e d\xE1 uma boa lavada nela?
      :)"
    m_Metadata:
      m_Items: []
  - m_Id: 655892767424512
    m_Localized: "Minha neta est\xE1 t\xE3o grande! Agora vamos para casa, estou
      morrendo de fome!"
    m_Metadata:
      m_Items: []
  - m_Id: 656053900001280
    m_Localized: "Nossa, voc\xEA n\xE3o imagina o quanto minhas costas doem! \u200B\u200BVoc\xEA
      poderia me dobrar para que eu possa ser carregada na sua mochilinha?"
    m_Metadata:
      m_Items: []
  - m_Id: 656153699270656
    m_Localized: '[Toca E para dobrar a Granny.]'
    m_Metadata:
      m_Items: []
  - m_Id: 656247265804288
    m_Localized: "Muito obrigada, Kami. J\xE1 consigo sentir o cheiro das salsichas
      dentro da minha mochila. Vamos, vamos comer!"
    m_Metadata:
      m_Items: []
  - m_Id: 656294703382528
    m_Localized: "Mas guarde espa\xE7o para a sobremesa, porque eu fiz um monte de
      biscoitos!"
    m_Metadata:
      m_Items: []
  - m_Id: 656360126136320
    m_Localized: "[ESTE \xC9 O FIM DESTE LIVRO]"
    m_Metadata:
      m_Items: []
  - m_Id: 656639550668800
    m_Localized: "chin\xEAs"
    m_Metadata:
      m_Items: []
  - m_Id: 656721972936704
    m_Localized: "Bom dia! Olha quem est\xE1 aqui!"
    m_Metadata:
      m_Items: []
  - m_Id: 656803698950144
    m_Localized: "Ei, voc\xEA sabia que o forno n\xE3o liga? O vento est\xE1 muito
      forte hoje..."
    m_Metadata:
      m_Items: []
  - m_Id: 656879393554432
    m_Localized: "Voc\xEA pode me trazer 100 folhas de papel? N\xE3o se preocupe,
      voc\xEA n\xE3o precisa traz\xEA-las agora. Voc\xEA pode ir e voltar entre as
      p\xE1ginas quando quiser."
    m_Metadata:
      m_Items: []
  - m_Id: 657038307344384
    m_Localized: "\xD3timo! Muito obrigada. Agora me passe a tesoura por um instante."
    m_Metadata:
      m_Items: []
  - m_Id: 657081387040768
    m_Localized: "Muito bem, aqui est\xE1. Agora voc\xEA pode cortar algumas pedras
      com a sua tesoura!"
    m_Metadata:
      m_Items: []
  - m_Id: 657144913969152
    m_Localized: "Espero que a tesoura melhorada seja \xFAtil para voc\xEA!"
    m_Metadata:
      m_Items: []
  - m_Id: 657248433586176
    m_Localized: Bom dia, Kami!
    m_Metadata:
      m_Items: []
  - m_Id: 657286689832960
    m_Localized: Desculpe incomodar, mas preciso muito da sua ajuda com algo.
    m_Metadata:
      m_Items: []
  - m_Id: 657288740847616
    m_Localized: "Estou preparando algumas po\xE7\xF5es especiais, mas acabei de
      ficar sem FLORES VIOLETA, preciso delas desesperadamente!"
    m_Metadata:
      m_Items: []
  - m_Id: 657290133356544
    m_Localized: "Elas s\xE3o grandes e chamam muita aten\xE7\xE3o, mas n\xE3o posso
      sair da minha barraca para ir busc\xE1-las! Por favor, voc\xEA poderia encontrar
      tr\xEAs e trazer para mim? Obrigada, Kami, voc\xEA \xE9 demais!"
    m_Metadata:
      m_Items: []
  - m_Id: 657748046495744
    m_Localized: "As flores violetas s\xE3o como estas que voc\xEA v\xEA aqui. Voc\xEA
      poderia me trazer tr\xEAs, por favor?"
    m_Metadata:
      m_Items: []
  - m_Id: 657925180342272
    m_Localized: Obrigada por me trazer as flores!
    m_Metadata:
      m_Items: []
  - m_Id: 657926950338560
    m_Localized: "Como voc\xEA tem sido t\xE3o gentil comigo, vou te dar estes pap\xE9is.
      Sei que voc\xEA tem muito talento para origami, ent\xE3o tenho certeza de que
      voc\xEA os usar\xE1 muito bem!"
    m_Metadata:
      m_Items: []
  - m_Id: 657928351236096
    m_Localized: '[Kami recebe 50 documentos de Dalia.]'
    m_Metadata:
      m_Items: []
  - m_Id: 658716536455168
    m_Localized: Obrigada por me trazer as flores!
    m_Metadata:
      m_Items: []
  - m_Id: 660063197446144
    m_Localized: "Kami, Kami! Voc\xEA tem que me ajudar!"
    m_Metadata:
      m_Items: []
  - m_Id: 660088149360640
    m_Localized: "A vov\xF3 sumiu de novo. Ela saiu para dar uma caminhada h\xE1
      pouco e ainda n\xE3o voltou!"
    m_Metadata:
      m_Items: []
  - m_Id: 660089567035392
    m_Localized: "Voc\xEA n\xE3o vai procur\xE1-la? Estou prestes a colocar as lingui\xE7as
      na grelha, o churrasco vai ficar arruinado de novo!"
    m_Metadata:
      m_Items: []
  - m_Id: 660091592884224
    m_Localized: "Pegue a TESOURA, ela est\xE1 perto da galp\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 660424608038912
    m_Localized: "V\xE1 procurar a vov\xF3, vamos comer!"
    m_Metadata:
      m_Items: []
  - m_Id: 660494095073280
    m_Localized: "Voc\xEA voltou para pegar suas Botas de Leitura Din\xE2mica, n\xE3o
      foi? Voc\xEA as deixou aqui. Com elas, voc\xEA consegue ler o livro mais r\xE1pido."
    m_Metadata:
      m_Items: []
  - m_Id: 660496028647424
    m_Localized: "[Kami recebe suas Botas de Leitura R\xE1pida. Segure SHIFT para
      ir mais r\xE1pido.]"
    m_Metadata:
      m_Items: []
  - m_Id: 660498415206400
    m_Localized: "E a\xED? Encontrou a vov\xF3? Onde ela est\xE1?"
    m_Metadata:
      m_Items: []
  - m_Id: 660504731828224
    m_Localized: "[Pressiona a tecla E para desdobrar a av\xF3.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661274998980608
    m_Localized: "Joya, diga \xE0 vov\xF3 que as salsichas est\xE3o prontas!"
    m_Metadata:
      m_Items: []
  - m_Id: 661432029528064
    m_Localized: "Kami! Por favor, me ajude!"
    m_Metadata:
      m_Items: []
  - m_Id: 661435837956096
    m_Localized: "As galinhas est\xE3o presas do outro lado do rio! Preciso que voc\xEA
      corte aquela \xE1rvore para que caia e fa\xE7a uma ponte."
    m_Metadata:
      m_Items: []
  - m_Id: 661449255534592
    m_Localized: "Voc\xEA por acaso n\xE3o tem uma tesoura?"
    m_Metadata:
      m_Items: []
  - m_Id: 661548048171008
    m_Localized: "Preciso que voc\xEA corte aquela \xE1rvore!"
    m_Metadata:
      m_Items: []
  - m_Id: 661576607186944
    m_Localized: "Obrigada! Veja, as galinhas j\xE1 est\xE3o atravessando. Aqui, tome
      isso como recompensa."
    m_Metadata:
      m_Items: []
  - m_Id: 661588523204608
    m_Localized: "[Com essas botas de \xE1gua, voc\xEA n\xE3o ter\xE1 medo do rio!]"
    m_Metadata:
      m_Items: []
  - m_Id: 661653480390656
    m_Localized: "Obrigada pela ajuda, Kami! As galinhas est\xE3o felizes na faz\xEDenda."
    m_Metadata:
      m_Items: []
  - m_Id: 661833231482880
    m_Localized: "[As meninas est\xE3o saboreando um delicioso chouri\xE7o.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661836435931136
    m_Localized: "[A m\xE3o gigante do Narrador aparece.]"
    m_Metadata:
      m_Items: []
  - m_Id: 661838587609088
    m_Localized: "O que voc\xEA fez?! Venha aqui."
    m_Metadata:
      m_Items: []
  - m_Id: 661840252747776
    m_Localized: Por que fazer figuras de origami dos outros personagens?
    m_Metadata:
      m_Items: []
  - m_Id: 661841552982016
    m_Localized: "Voc\xEA n\xE3o pode ficar mudando as hist\xF3rias assim! A vov\xF3
      nunca deveria ter sa\xEDdo daquela p\xE1gina..."
    m_Metadata:
      m_Items: []
  - m_Id: 661842916130816
    m_Localized: "Agora vamos ler outro livro,\n\n\"Crime, Castigo e Sangue\". Vamos
      ver se voc\xEA aprende alguma coisa..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000000
    m_Localized: "Natalia"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000001
    m_Localized: "...e se esse tal de Ariel me seguir de novo, eu mesma vou mult\xE1-lo."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000002
    m_Localized: "Ah! Desculpa, n\xE3o te vi. Natalia, detetive. Bom... quase."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000003
    m_Localized: "Coisas n\xE3o param de sumir do museu. Uma s\xE9rie de roubos, e todo mundo age como se nada tivesse acontecido."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000004
    m_Localized: "E ainda por cima, o Ariel passou o dia inteiro atr\xE1s de mim no trabalho, fazendo perguntas. S\xF3 agora me deixou em paz."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000005
    m_Localized: "Voc\xEA tem tesoura e cara de quem n\xE3o se assusta com nada. Um chocolate quente enquanto eu te conto o caso?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000006
    m_Localized: "Vem, o caf\xE9 \xE9 logo ali."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000007
    m_Localized: "Fica comigo, as pistas n\xE3o v\xE3o se procurar sozinhas."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000008
    m_Localized: "E se voc\xEA vir o Ariel... me avisa antes que ele me veja."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000100
    m_Localized: "Uma luva sozinha! Algu\xE9m saiu com as m\xE3os frias... Vamos guardar: essa pista est\xE1 na palma da nossa m\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000101
    m_Localized: "Um chap\xE9u preso no bueiro! O ladr\xE3o saiu com tanta pressa que perdeu a cabe\xE7a... bom, o chap\xE9u."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000102
    m_Localized: "Um rel\xF3gio quebrado... parou bem na hora do roubo. O tempo do ladr\xE3o acabou!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000103
    m_Localized: "Olha! Os policiais que vigiavam a cena do crime foram embora! Talvez a gente consiga abrir caminho na tesoura pra procurar mais pistas!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000104
    m_Localized: "Vamos direto ao corte!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000105
    m_Localized: "Essas tr\xEAs pistas devem nos dar uma \xF3tima vantagem."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000106
    m_Localized: "Vamos pra casa analisar melhor. Esse caso est\xE1 come\xE7ando a se desdobrar!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000107
    m_Localized: "Um presente gigante... na MINHA porta? O que \xE9 isso?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000108
    m_Localized: "S\xF3 tem um jeito de descobrir. Vamos cortar a fita!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000109
    m_Localized: "Continua embrulhado. Ser\xE1 que sua tesoura d\xE1 uma m\xE3ozinha?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000110
    m_Localized: "Ariel"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000111
    m_Localized: "Pol\xEDcia Federal"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000112
    m_Localized: "Kami... \xE9 o Pelusa! O ORIGINAL!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000113
    m_Localized: "Temos que levar de volta pro museu! Espera, tem uma carta dobrada aqui dentro..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000114
    m_Localized: "Vamos desdobrar. Tem alguma coisa nesse caso que n\xE3o se encaixa."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000115
    m_Localized: "POL\xCDCIA FEDERAL! Ningu\xE9m se mexe!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000116
    m_Localized: "Policiais! L\xE1 est\xE3o as ladras! Com o Pelusa nas m\xE3os!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000117
    m_Localized: "Ariel?! O que voc\xEA... a gente n\xE3o roubou nada!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000118
    m_Localized: "Ent\xE3o expliquem a carta. \"Esta \xE9 a sua parte\"... que fofo."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000119
    m_Localized: "Voc\xEAs duas v\xEAm com a gente. M\xE3os onde eu possa ver!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000120
    m_Localized: "\xD3timo. Emolduradas... feito um quadro."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000121
    m_Localized: "Surpresa! Acharam que eu ia perder a fuga?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000122
    m_Localized: "V\xE1 pegar suas coisas e vamos libertar sua amiga, querida."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000123
    m_Localized: "Depois de serem enganadas, e quando tudo parecia perdido, um tremendo alvoro\xE7o se ouviu no telhado."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000124
    m_Localized: "Grace"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000125
    m_Localized: "Antes de irmos, dobra aquele papel do caf\xE9 no pedestal. Uma boa detetive nunca joga um recibo fora."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000126
    m_Localized: "Bela dobra! Guarda esse recibo, nunca se sabe quando um comprovante vai salvar a sua pele."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000127
    m_Localized: "Me diz... voc\xEA n\xE3o \xE9 deste jornal, \xE9? A sua tinta \xE9 diferente."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000128
    m_Localized: "Algu\xE9m te arrastou de outro livro pra c\xE1? Contra a sua vontade? Que horror."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000129
    m_Localized: "Vamos fazer um trato: me ajuda a procurar pistas esta noite, e amanh\xE3 de manh\xE3 a gente descobre um jeito de te mandar de volta pro seu livro. Combinado?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000130
    m_Localized: "Sou a Grace, diretora deste museu. Sem provas, receio que n\xE3o posso acreditar em nada do que dizem."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000134
    m_Localized: "E ent\xE3o? Vamos ver esse recibo."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000144
    m_Localized: "A catapulta est\xE1 pronta quando voc\xEAs quiserem. N\xE3o esquece de se despedir da Natalia!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000145
    m_Localized: "Ent\xE3o \xE9 um adeus, parceira. O melhor caso que j\xE1 resolvi... e tamb\xE9m o primeiro."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000146
    m_Localized: "Manda um oi pro seu livro. E se um dia precisar de uma detetive, voc\xEA sabe em que p\xE1gina me encontrar."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000147
    m_Localized: "Segura firme, querida! N\xE3o voo desde a grande guerra de travesseiros de 58."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000148
    m_Localized: "Kami e a av\xF3 voaram por cima dos telhados do jornal, direto para a dobra do pr\xF3prio livro..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000149
    m_Localized: "...at\xE9 que bateram em algo grande, redondo e azul: a lumin\xE1ria da escrivaninha do Narrador."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000150
    m_Localized: "Desviadas, ca\xEDram entre as p\xE1ginas de um livro que nunca tinham lido."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000151
    m_Localized: "L\xE1 est\xE3o elas, policiais! As fugitivas! E ainda est\xE3o com a Pelusa!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000152
    m_Localized: "Ningu\xE9m se mexe! Voc\xEAs duas v\xE3o direto de volta pras celas."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000153
    m_Localized: "Esperem, policiais. Sou a Grace, diretora deste museu. Se elas roubaram a Pelusa... por que a devolveriam?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000154
    m_Localized: "Porque a gente nunca roubou! Eu sou a Natalia, e esta \xE9 a Kami. Armaram pra gente, e podemos provar."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000155
    m_Localized: "Kami, o nosso recibo do caf\xE9! Desdobra e mostra pra eles."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000169
    m_Localized: "R\xE1dio"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000170
    m_Localized: "...urgente: mais um incidente no museu da cidade, h\xE1 poucos minutos. A Pelusa, o quadro mais valioso do acervo, desapareceu..."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000171
    m_Localized: "A Pelusa?! Mais um, e bem agora! Vamos, Kami, pro museu. As pistas n\xE3o esperam!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000172
    m_Localized: "Viram o hor\xE1rio? 21:47, o minuto exato em que a Pelusa sumiu. N\xF3s duas est\xE1vamos no caf\xE9, tomando um chocolate quente."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000173
    m_Localized: "A gente soube do roubo pelo r\xE1dio do caf\xE9, como todo mundo!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000174
    m_Localized: "Um recibo n\xE3o prova nada! Voc\xEAs... voc\xEAs podem ter pago e sa\xEDdo correndo!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000175
    m_Localized: "Ah, \xE9? Ent\xE3o de quem \xE9 o chap\xE9u que ficou preso no bueiro do museu? E a luva no lixo?"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000176
    m_Localized: "S\xE3o seus, Ariel. E este rel\xF3gio estava ca\xEDdo no p\xE1tio do museu, parado \xE0s 21:47."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000177
    m_Localized: "Ariel... o seu pai \xE9 o maior benfeitor deste museu. Voc\xEA podia entrar e sair de qualquer sala quando quisesse."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000178
    m_Localized: "O dia inteiro sem me deixar em paz no trabalho. Justo na noite em que voc\xEA me deixou sossegada, a Pelusa sumiu."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000179
    m_Localized: "Hmm... tudo confere, e aposto que os outros roubos tamb\xE9m. Senhoritas, a Pol\xEDcia Federal deve desculpas a voc\xEAs. Ariel, voc\xEA vem com a gente!"
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000180
    m_Localized: "Natalia... me desculpa. Eu nunca quis que a culpa ca\xEDsse em voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000181
    m_Localized: "Obrigada, meninas. A Pelusa voltou pra casa gra\xE7as a voc\xEAs."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000182
    m_Localized: "Tem mais uma coisa, Grace. A Kami n\xE3o \xE9 daqui: ela precisa voltar pro pr\xF3prio livro."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000183
    m_Localized: "Ent\xE3o tenho exatamente o que voc\xEAs precisam. A pe\xE7a mais antiga do museu \xE9 uma catapulta: dizem que ela lan\xE7a qualquer coisa de volta pras p\xE1ginas de onde veio."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000184
    m_Localized: "Uma catapulta? Ai, que emo\xE7\xE3o! Eu tamb\xE9m vou, querida."
    m_Metadata:
      m_Items: []
  - m_Id: 661900000000185
    m_Localized: "Ent\xE3o subam as duas, e cortem a corda quando estiverem prontas."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
